# Workspace-Specific Dedicated API Keys (Run all assistants simultaneously with distinct keys)
# CHAT_API_KEY: Dedicated API key for General Chat Assistant
CHAT_API_KEY=""

# DEEP_SEARCH_API_KEY: Dedicated API key for Deep Search Assistant
DEEP_SEARCH_API_KEY=""

# WEB_DESIGN_API_KEY: Dedicated API key for Web Design & Code Assistant
WEB_DESIGN_API_KEY=""

# CODEX_API_KEY: OpenAI / Codex API key for Web Design & Code Generation
CODEX_API_KEY=""

# OPENAI_API_KEY: OpenAI API key for Codex / GPT-4o / Web Design
OPENAI_API_KEY=""

# NOTES_API_KEY: Dedicated API key for Notes Maker & Academic Assistant
NOTES_API_KEY=""

# IMAGE_VIDEO_API_KEY: Dedicated API key for Visual & Media Assistant
IMAGE_VIDEO_API_KEY=""

# Global AI Provider API Keys
# GROQ_API_KEY: Required for Groq AI API calls.
GROQ_API_KEY=""

# ANTHROPIC_API_KEY: Required for Claude / Opus (Opus 4.8, Claude 3 Opus) AI API calls.
ANTHROPIC_API_KEY=""

# OPUS_API_KEY: Optional alias for Opus 4.8 / Claude Opus API key.
OPUS_API_KEY=""

# OPENROUTER_API_KEY: Optional key for OpenRouter (supports Claude 3 Opus, 3.7 Sonnet, etc.)
OPENROUTER_API_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TAVILY_API_KEY: Required for Web Research workspace using Tavily Search API.
TAVILY_API_KEY=""

# OLLAMA CONFIGURATION (For Offline / Local Model Mode)
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="llama3.2"

# GITHUB OAUTH CONFIGURATION
# GITHUB_CLIENT_ID: Your GitHub OAuth App Client ID (from github.com/settings/developers)
GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET: Your GitHub OAuth App Client Secret
GITHUB_CLIENT_SECRET=""


