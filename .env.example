# Core
NODE_ENV=production
PORT=10000

# App URL (Render will provide this after deploy)
APP_URL=https://nexus-ai-backend.onrender.com

# API Keys (Add your keys here)
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Workspace-specific keys (optional)
CHAT_API_KEY=
WEB_DESIGN_API_KEY=
DEEP_SEARCH_API_KEY=
NOTES_API_KEY=
IMAGE_VIDEO_API_KEY=

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local Ollama (for offline mode)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2